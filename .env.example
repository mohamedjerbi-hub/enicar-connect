# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://db:5432/enicar_db
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Authentication
# Must be at least 256-bit safe random string
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS limits
CORS_ORIGINS=http://your_frontend_domain_or_localhost
